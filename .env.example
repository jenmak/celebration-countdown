DATABASE_URL=postgresql://postgres:postgres@localhost:5433/celebrationcountdown?schema=public

# Backend
APP_NAME=celebrationcountdown-backend
APP_PORT=3001
NODE_ENV=development

# AWS (IAM user access key — needs Cognito + S3 permissions)
AWS_REGION=us-east-1
AWS_ACCESS_KEY=
AWS_SECRET=

# Cognito (app client must have NO client secret; enable USER_PASSWORD_AUTH)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# S3 (contact photo uploads)
S3_BUCKET=

# Anthropic (extract gift search terms from contact notes)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Frontend
VITE_API_URL=http://127.0.0.1:3001
